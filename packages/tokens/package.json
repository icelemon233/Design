{
  "name": "@cinna-design/tokens",
  "version": "0.2.0",
  "private": true,
  "description": "Colors, spacing and motion tokens for Design.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": "Cinna"
}
